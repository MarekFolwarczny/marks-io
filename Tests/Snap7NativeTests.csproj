<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="OpcUaIntegration.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Include="../Snap7Codec.cs" Link="Snap7Codec.cs" />
    <Compile Include="../Snap7Transport.cs" Link="Snap7Transport.cs" />
    <Content Include="../Native/snap7.dll" Link="snap7.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
